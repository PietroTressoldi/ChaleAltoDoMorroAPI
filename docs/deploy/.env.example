# =====================================================================================
#  Chalé Alto do Morro — TODAS as variáveis de ambiente de produção
#  Passo a passo completo do deploy: docs/deploy/DEPLOY_HOSTINGER.md
# =====================================================================================
#
#  COMO USAR
#  - Parte 1 e Parte 2 → no SERVIDOR (VPS), num arquivo chamado ".env" ao lado do
#    docker-compose.prod.yml. Depois: chmod 600 .env
#  - Parte 3 → variáveis de ambiente do projeto da LANDING no Cloudflare Pages
#  - Parte 4 → variáveis de ambiente do projeto do PORTAL no Cloudflare Pages
#
#  REGRAS DE OURO
#  - Troque TODO "<...>" pelo valor real. Troque "seudominio.com.br" pelo domínio real.
#  - Sem aspas, sem espaço antes ou depois do "=".
#  - "__" (dois sublinhados) = o ":" do appsettings. Ex.: Jwt__Key = Jwt:Key
#  - O .env com os valores reais NUNCA vai para o git. Guarde uma cópia no gerenciador de senhas.
#  - Este arquivo (.env.example) pode ir para o git: só tem exemplos, nenhum segredo.
#
#  🔒 = segredo        🌐 = pode ser público
# =====================================================================================


# -------------------------------------------------------------------------------------
#  PARTE 1 — POSTGRES (servidor)
#  ⚠️ O Postgres só lê estas 3 na PRIMEIRA vez que cria o banco. Mudar depois não muda nada.
# -------------------------------------------------------------------------------------

# 🌐 Nome do banco
POSTGRES_DB=chale_alto_do_morro

# 🌐 Usuário do banco
POSTGRES_USER=chale_admin

# 🔒 Senha do banco. Gere no servidor com:  openssl rand -hex 32
#    (hex de propósito: sem ; = + / que quebram a connection string). NUNCA use "chale_dev".
POSTGRES_PASSWORD=<cole-aqui-o-resultado-do-openssl-rand-hex-32>


# -------------------------------------------------------------------------------------
#  PARTE 2 — API .NET + CADDY (servidor)
# -------------------------------------------------------------------------------------

# 🌐 Domínio da API. O Caddy usa para pegar o certificado HTTPS. Sem https:// e sem barra.
API_DOMAIN=api.seudominio.com.br

# 🔒 Conexão com o banco.
#    Host=postgres  → é o NOME DO SERVIÇO no docker-compose (não é localhost!)
#    Port=5432      → porta de DENTRO do Docker (não é a 5433 do seu PC)
#    Password       → a MESMA senha do POSTGRES_PASSWORD lá de cima
ConnectionStrings__Default=Host=postgres;Port=5432;Database=chale_alto_do_morro;Username=chale_admin;Password=<mesma-senha-do-POSTGRES_PASSWORD>

# 🔒 Chave que assina o login do portal. Gere com:  openssl rand -base64 48
#    Mínimo 32 caracteres (a API não sobe com menos). Diferente da de desenvolvimento.
#    Se trocar, todo mundo é deslogado (só isso).
Jwt__Key=<cole-aqui-o-resultado-do-openssl-rand-base64-48>

# 🔒 Admin inicial do portal. Só é usado na PRIMEIRA subida, para criar o usuário.
#    Senha com 10+ caracteres. Depois de entrar no portal e trocar a senha, pode APAGAR
#    estas duas linhas e reiniciar a API (o admin já existe; aparece só um aviso no log).
AdminSeed__Email=<seu-email@exemplo.com>
AdminSeed__Password=<senha-forte-com-10-ou-mais-caracteres>

# 🌐 Quem pode chamar a API pelo navegador (CORS).
#    https, tudo minúsculo, SEM barra no fim (senão a API não sobe).
#    Landing (o site):
Cors__AllowedOrigins__0=https://seudominio.com.br
Cors__AllowedOrigins__1=https://www.seudominio.com.br
#    Portal de gestão:
Cors__PortalOrigins__0=https://portal.seudominio.com.br

# 🌐 Onde ficam as fotos/vídeos enviados pelo portal.
#    "Local" = no disco do servidor (volume do Docker), servido pela própria API em /uploads.
Storage__Provider=Local
#    De onde o navegador baixa as fotos. COM barra no fim.
Storage__PublicBaseUrl=https://api.seudominio.com.br/uploads/

# ---- Só se um dia trocar as fotos do disco para um bucket S3 (seção "Extra" do DEPLOY_AWS.md) ----
# Storage__Provider=S3
# Storage__BucketName=chale-uploads
# Storage__PublicBaseUrl=https://<id-da-distribuicao>.cloudfront.net/
# AWS__Region=sa-east-1
#    Credenciais da AWS: NÃO coloque aqui. Na EC2 elas vêm da IAM Role da máquina.
#    Fora da AWS (Hostinger) não existe IAM Role: o S3 exigiria chave de usuário IAM. Fique no Local.

# ---- Já definidas, NÃO precisa colocar no .env ----
# ASPNETCORE_ENVIRONMENT=Production   → já está no Dockerfile
# Jwt__Issuer / Jwt__Audience / Jwt__ExpiresMinutes → já estão no appsettings.json


# -------------------------------------------------------------------------------------
#  PARTE 3 — LANDING (React) → Cloudflare Pages: Settings → Environment variables
#  ⚠️ Tudo que começa com VITE_ vai DENTRO do site e qualquer pessoa consegue ver.
#     NUNCA coloque segredo aqui. Mudou? Deployments → Retry deployment.
# -------------------------------------------------------------------------------------

# 🌐 Endereço da API. SEM barra no fim. Vazio = o site usa dados FALSOS (preço falso!).
# VITE_API_URL=https://api.seudominio.com.br

# 🌐 Pixel da Meta (Facebook/Instagram). Opcional: vazio = pixel desligado.
# VITE_META_PIXEL_ID=<id-do-pixel>


# -------------------------------------------------------------------------------------
#  PARTE 4 — PORTAL DE GESTÃO (React) → Cloudflare Pages: Settings → Environment variables
#  ⚠️ Mesmo aviso: VITE_ é público e entra no build.
# -------------------------------------------------------------------------------------

# 🌐 Endereço da API. SEM barra no fim.
# VITE_API_URL=https://api.seudominio.com.br

# 🌐 Dados falsos desligados. NUNCA "true" em produção.
# VITE_USE_MOCKS=false
